# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/src/generated/prisma

# IDE
.idea/
.vscode/
*.swp
*.swo

# ---- Arquitetura de IA/Agentes (bootstrap) ----
# Decisão de 2026-10-05: .agents/, docs/, .claude/, .codex/, AGENTS.md, CLAUDE.md e PLANS.md SÃO versionados.
# Só configurações locais/pessoais das ferramentas ficam fora.
.claude/settings.local.json
.claude/worktrees/
.codex/config.local.toml

# ---- Constituição: dados financeiros reais nunca entram no Git ----
private/
/imports/
*.ofx
*.qfx
*.pdf
extratos/
faturas/
# Excecao: fixtures sinteticas (prefixo sintetico-) em tests/fixtures
!tests/fixtures/**

# ---- Sempre ignorar, independente da decisão acima ----
.env*
!.env.example
secrets/**
credentials/**
*.pem
*.key
*.crt
*.p12
*.pfx
backups/**
dumps/**
