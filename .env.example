# Database (use a pooled connection string in production — Neon dashboard)
DATABASE_URL="postgresql://user:password@localhost:5432/finance_controller?schema=public"
# Conexão DIRETA do Neon (sem -pooler), usada só por `npm run db:deploy`. Opcional: sem ela, usa DATABASE_URL.
# DIRECT_URL=""

# Next.js — URL publica da aplicacao (em producao, use o dominio da Vercel)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth — reservado (a sessao usa token aleatorio guardado como hash no banco; hoje nao e lido pelo codigo).
# Gere com: openssl rand -base64 32
SESSION_SECRET="change-me"

# Rotas sem cookie (cada uma exige o proprio segredo; ausente = acesso negado). Use >= 32 caracteres aleatorios.
# Vercel Cron: envia "Authorization: Bearer <CRON_SECRET>" quando a variavel existe no projeto.
# CRON_SECRET="change-me"
# Telegram: o mesmo valor vai em setWebhook (secret_token); chega em X-Telegram-Bot-Api-Secret-Token.
# TELEGRAM_WEBHOOK_SECRET="change-me"
# MCP: "Authorization: Bearer <MCP_TOKEN>".
# MCP_TOKEN="change-me"

# Criacao do dono (scripts/create-owner.ts, npm run owner:create). A senha NUNCA vai aqui: e pedida no terminal.
# OWNER_EMAIL=""
# OWNER_NAME=""
