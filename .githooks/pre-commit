#!/usr/bin/env bash
EXPECTED_NAME="Senavictors"
EXPECTED_EMAIL="victorsena760@gmail.com"

ACTUAL_NAME=$(git config user.name)
ACTUAL_EMAIL=$(git config user.email)

if [ "$ACTUAL_NAME" != "$EXPECTED_NAME" ] || [ "$ACTUAL_EMAIL" != "$EXPECTED_EMAIL" ]; then
  echo "ERROR: Commit identity mismatch!"
  echo "  Expected: $EXPECTED_NAME <$EXPECTED_EMAIL>"
  echo "  Got:      $ACTUAL_NAME <$ACTUAL_EMAIL>"
  echo ""
  echo "Fix with:"
  echo "  git config --local user.name \"$EXPECTED_NAME\""
  echo "  git config --local user.email \"$EXPECTED_EMAIL\""
  exit 1
fi

# --- Guard de dados reais (FC2-F0-07) -----------------------------------------------------------
# Varre apenas os arquivos staged (conteudo do indice). Bloqueia CPF/CNPJ/cartao/conta/e-mail/
# telefone e nomes fora do padrao em tests/fixtures. Corrija o dado; nao relaxe o detector.
# Se ja houver hook do plugin bootstrap, ele continua valendo: este bloco nao o substitui.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$STAGED" ]; then
  REPO_ROOT=$(git rev-parse --show-toplevel)
  if [ ! -x "$REPO_ROOT/node_modules/.bin/tsx" ] && [ ! -f "$REPO_ROOT/node_modules/.bin/tsx.cmd" ]; then
    echo "ERROR: guard de dados indisponivel (node_modules ausente). Rode 'npm ci' e tente de novo."
    exit 1
  fi
  if ! (cd "$REPO_ROOT" && npm run --silent guard:data:staged); then
    echo ""
    echo "Commit bloqueado pelo guard de dados (Constituicao: dados reais fora do Git)."
    exit 1
  fi
fi
