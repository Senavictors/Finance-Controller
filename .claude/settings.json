{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "agent": "orquestrador",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production*)",
      "Read(./.env.development.local)",
      "Bash(git push --force:*)"
    ],
    "ask": [
      "Read(./private/**)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npm run build:*)",
      "Bash(npx prisma migrate deploy:*)",
      "Bash(git push:*)"
    ]
  }
}
